# Board MCP server path (the agent-board mcp-server package)
BOARD_MCP_SERVER=/Users/xavierau/Documents/code/agent-board/packages/mcp-server/src/index.ts

# Org config path (agent-org org.yaml)
ORG_CONFIG=/Users/xavierau/Documents/code/agent-org/config/org.yaml

# Daemon settings
POLL_INTERVAL_MS=10000
OUTPUTS_DIR=./outputs
DEFAULT_MODEL=sonnet
DEFAULT_MAX_TURNS=15

# Which board column to poll for new tasks
TRIGGER_COLUMN=todo
DOING_COLUMN=doing
DONE_COLUMN=done

# Daemon actor identity (who the daemon acts as in the org)
DAEMON_ACTOR_ID=engineering-manager
